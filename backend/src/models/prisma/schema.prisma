datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. TÀI KHOẢN & NGƯỜI DÙNG
// ==========================================

enum Role {
  CUSTOMER
  ADMIN
  STAFF
}

model User {
  id          Int       @id @default(autoincrement())
  email       String?   @unique
  phoneNumber String    @unique // Đặt cafe thường ưu tiên đăng nhập/xác nhận bằng SĐT
  password    String    // Hash password (bcrypt/argon2)
  fullName    String
  avatar      String?
  role        Role      @default(CUSTOMER)

  addresses   Address[]
  orders      Order[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Địa chỉ nhận hàng (khách có thể lưu nhiều địa chỉ: Nhà, Công ty...)
model Address {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recipientName String  // Tên người nhận
  phoneNumber  String   // SĐT nhận hàng
  street       String   // Số nhà, tên đường
  ward         String?  // Phường / Xã
  district     String?  // Quận / Huyện
  city         String   // Tỉnh / Thành phố
  isDefault    Boolean  @default(false)

  orders       Order[]
}

// ==========================================
// 2. ĐƠN HÀNG (ORDER)
// ==========================================

enum OrderStatus {
  PENDING     // Chờ xác nhận
  PREPARING   // Đang pha chế
  DELIVERING  // Đang giao
  COMPLETED   // Hoàn thành
  CANCELLED   // Đã hủy
}

model Order {
  id              Int          @id @default(autoincrement())
  orderCode       String       @unique // Mã đơn dạng: CF-20260917-001
  
  // Khách hàng
  userId          Int?         // Cho phép null nếu hỗ trợ khách vãng lai (guest checkout)
  user            User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Địa chỉ giao hàng đã chọn
  addressId       Int?
  address         Address?     @relation(fields: [addressId], references: [id], onDelete: SetNull)
  shippingAddress String       // Snapshot lại địa chỉ dạng text phòng khi khách sửa/xóa sổ địa chỉ

  // Tiền & Trạng thái
  subtotal        Decimal      @db.Decimal(10, 2) // Tiền hàng
  shippingFee     Decimal      @default(0) @db.Decimal(10, 2) // Phí ship
  totalAmount     Decimal      @db.Decimal(10, 2) // Tổng thanh toán
  
  status          OrderStatus  @default(PENDING)
  paymentMethod   String       @default("COD") // COD, MOMO, VNPAY, BANK_TRANSFER
  isPaid          Boolean      @default(false)
  note            String?      // Ghi chú đơn: "Giao trước 10h, bấm chuông"

  items           OrderItem[]
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// ==========================================
// 3. SẢN PHẨM & TÙY BIẾN
// ==========================================

model Product {
  id           Int              @id @default(autoincrement())
  name         String
  description  String?          @db.Text
  basePrice    Decimal          @db.Decimal(10, 2)
  image        String?
  isBestSeller Boolean          @default(false)
  isActive     Boolean          @default(true) // Ẩn/Hiện món

  sizes        ProductSize[]
  toppings     ProductTopping[]
  orderItems   OrderItem[]

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model ProductSize {
  id         Int     @id @default(autoincrement())
  name       String  // Size S, Size M, Size L
  subText    String? // Tiêu chuẩn
  extraPrice Decimal @default(0) @db.Decimal(10, 2) // 0, 6000, 12000

  productId  Int
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Topping {
  id         Int                @id @default(autoincrement())
  name       String             // Trân châu đen, Kem Cheese,...
  price      Decimal            @db.Decimal(10, 2)

  products   ProductTopping[]
  orderItems OrderItemTopping[]
}

model ProductTopping {
  productId Int
  toppingId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  topping   Topping @relation(fields: [toppingId], references: [id], onDelete: Cascade)

  @@id([productId, toppingId])
}

// ==========================================
// 4. CHI TIẾT TỪNG MÓN TRONG ĐƠN (ORDER ITEM)
// ==========================================

model OrderItem {
  id          Int                @id @default(autoincrement())
  
  orderId     Int
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productId   Int
  product     Product            @relation(fields: [productId], references: [id])
  
  quantity    Int                @default(1)
  sizeName    String             // "Size M"
  sizePrice   Decimal            @db.Decimal(10, 2) // 6000
  sweetness   String             // "70%"
  ice         String             // "Chuẩn"
  unitPrice   Decimal            @db.Decimal(10, 2) // Giá 1 ly hoàn chỉnh sau khi cộng size + topping

  toppings    OrderItemTopping[]
}

model OrderItemTopping {
  id          Int       @id @default(autoincrement())
  orderItemId Int
  toppingId   Int
  price       Decimal   @db.Decimal(10, 2) // Snapshot giá topping tại thời điểm mua

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  topping     Topping   @relation(fields: [toppingId], references: [id])
}